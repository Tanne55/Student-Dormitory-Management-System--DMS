# ===== App =====
NODE_ENV=development
LISTEN_PORT=3001

# CORS: cach nhau bang dau phay neu nhieu domain
# Vi du: https://ktx.edu.vn,https://admin.ktx.edu.vn
CORS_ORIGIN=http://localhost:3000

# URL frontend, dung de build link trong email (vd: reset password)
APP_URL=http://localhost:3000

# ===== Database (MySQL 8) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=qliktx
DB_PASS=123456
DB_NAME=qliktx

# ===== JWT =====
# BAT BUOC: chuoi ngau nhien dai >= 32 ky tu. Backend khong start neu thieu hoac qua ngan.
# Tao bang: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ===== Mail (SMTP) =====
# Bo trong neu chua dung. Khi co du HOST/PORT/FROM thi MailService se khoi tao transporter.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_SECURE=false

# ===== VNPay (phase 2, scaffold) =====
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return
VNPAY_IPN_URL=http://localhost:3001/vnpay/ipn
